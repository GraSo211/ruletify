---
import Preloader from "../components/Preloader";
import Layout from "../layouts/Layout.astro";
import RuletaAllSection from "../section/RuletaAllSection";
---

<Layout title="Ruletify">
    <main class="relative min-h-screen w-full overflow-hidden">
        <Preloader></Preloader>
        <RuletaAllSection client:only />
    </main>

    <style>
        :root {
            --giro: 0;
        }
        main {
            margin: auto;
            width: 100%;
            min-height: 100vh;
        }
    </style>
</Layout>
