---
import Layout from "../layouts/Layout.astro";
import RuletaAllSection from "../section/RuletaAllSection";
---

<Layout title="Ruletify">
    <main class="flex flex-row justify-around items-center">
        <div class="div div1 hd:text-7xl full-hd:text-8xl 2k:text-9xl hidden hd:grid"><span class="span block p-2 bg-white"><span class="block bg-[#121317] p-3"><h1>RULETIFY</h1></span></span></div>
        <div class="div div2 hd:text-7xl full-hd:text-8xl 2k:text-9xl hidden hd:grid "><span class="span block p-2 bg-white"><span class="block bg-[#121317] p-3"><h1>RULETIFY</h1></span></span></div>
        <RuletaAllSection client:only />
    </main>

    <style>
        :root {
            --giro: 0;
        }
        main {
            margin: auto;
            width: 100%;
            height: 100%;
        }

        .div {
            position: absolute;
            width: 100%;
            height: 100%;
            z-index: 1000;
            place-content: center;
            font-weight: bold;
            background-color: #121317;
            overflow: hidden;
        }

        .div1 {
            clip-path: polygon(0% 0%, 100% 0%, 0% 100%);
            animation: desplazarArriba 2s 0.5s forwards;
        }

        .div2 {
            clip-path: polygon(100% 100%, 0% 100%, 99% 0%);
            animation: desplazarAbajo 2s 0.5s forwards;
        }
        h1 {
            background: repeating-linear-gradient(-45deg, red 7%, orange 14%, yellow 21%, green 28%, blue 35%, violet 42%, red 50%);
            background-size: 600vw 600vw;
            background-clip: text;
            color: transparent;
            animation: rainbow 5s linear infinite alternate;
        }
        .span {
            background: repeating-linear-gradient(-45deg, red 7%, orange 14%, yellow 21%, green 28%, blue 35%, violet 42%, red 50%);
            background-size: 600vw 600vw;
            background-clip: border-box;
            color: transparent;
            animation: rainbow 5s linear infinite alternate;
        }
        @keyframes rainbow {
            0% {
                background-position-x: 250vw;
            }
            100% {
                background-position-x: 600vw;
            }
        }

        @keyframes desplazarArriba {
            from {
                transform: translate(0, 0);
            }
            to {
                transform: translate(-100vw, -100vh);
                opacity: 0;
                display: none;
            }
        }
        @keyframes desplazarAbajo {
            from {
                transform: translate(0, 0);
            }
            to {
                transform: translate(100vw, 100vh);
                opacity: 0;
                display: none;
            }
        }
    </style>
</Layout>
