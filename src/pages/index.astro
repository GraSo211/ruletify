---
import Preloader from "../components/Preloader";
import Layout from "../layouts/Layout.astro";
import RuletaAllSection from "../section/RuletaAllSection";
---

<Layout title="Ruletify">
    <main class="flex flex-row justify-around items-center relative overflow-hidden">
        <Preloader></Preloader>
        <RuletaAllSection client:only />
    </main>

    <style>
        :root {
            --giro: 0;
        }
        main {
            margin: auto;
            width: 100%;
            height: 100%;
        }
    </style>
</Layout>
